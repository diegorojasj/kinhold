# Database (Postgres, supabase/postgres image). DB_USER / DB_PASSWORD / DB_NAME are the services' own role
# and database, created on the first start of the database volume. DB_HOST/DB_PORT are for running a
# service or its tests outside the containers (compose publishes Postgres on localhost:54322).
DB_HOST=localhost
DB_PORT=54322
DB_USER=kinAdmin
DB_PASSWORD=1234
DB_NAME=kinhold
# Password of the image's own "postgres" role (the services never use it).
DB_SUPERUSER_PASSWORD=change-me

# Backend services (services/). GATEWAY_SECRET is shared by the API gateway and every service: requests
# without it are rejected, so a service is only reachable through the gateway.
DJANGO_SECRET_KEY=change-me
GATEWAY_SECRET=change-me
# For running a service outside the containers; compose sets its own.
VALKEY_URL=valkey://localhost:6379/0

# Frontend (frontend/)
# Where `pnpm dev` proxies /api (the gateway). The frontend-dev container overrides it.
API_GATEWAY_URL=http://localhost:8000
# Absolute API origin, only for native builds (Capacitor serves the app from capacitor://localhost, so a
# relative /api doesn't reach the server). e.g. https://kinhold.example.com. Leave empty for the web.
VITE_API_URL=
# Only DEV, native live reload: URL of the Vite dev server on your LAN
# e.g. http://192.168.1.20:3000. Leave empty for release builds (the app then uses the bundled dist/).
CAP_SERVER_URL=
